# ---- Core ----
NODE_ENV=development
PORT=4000

# MongoDB. Local for dev, Atlas connection string for deploy.
MONGODB_URI=mongodb://127.0.0.1:27017/hulu_web_platform

# ---- Auth ----
# Generate strong, independent secrets for deploy: `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Playback URL signing (separate from auth so a leaked JWT can't mint playback links).
PLAYBACK_SECRET=dev_playback_secret_change_me
PLAYBACK_TTL_SECONDS=300

# Comma-separated list of allowed client origins.
CORS_ORIGIN=http://localhost:5173

# ---- Billing ----
# Leave STRIPE_SECRET_KEY empty to run the built-in mock provider (no Stripe account needed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
FRONTEND_URL=http://localhost:5173

# ---- Recommendation job ----
# When true, recomputeSimilarity runs on an interval inside the API process.
# On Render prefer a scheduled Cron job service instead.
RUN_RECOMMENDER_IN_PROCESS=false
RECOMMENDER_INTERVAL_MINUTES=360

# ---- Demo media ----
# Public/sample video URLs used by the seeded catalogue.
MEDIA_BASE_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample

# ---- Catalogue import (optional, free) ----
# The Movie Database key: real titles, official artwork, episode names and runtimes.
# Leave empty to seed the built-in fictional catalogue instead.
# Accepts either credential TMDB issues (a v4 read access token or a v3 API key).
# Server-side only: image.tmdb.org needs no key, so the browser never sees this.
# Never used at request time — it is read by `npm run seed`.
TMDB_API_KEY=
