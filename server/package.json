{
  "name": "hulu-web-platform-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the Hulu Web Platform portfolio build: auth, entitlement, playback, billing, recommendations.",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:catalogue": "node src/seed/seed.js --catalogue-only",
    "recompute": "node src/jobs/recomputeSimilarity.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "stripe": "^16.9.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
